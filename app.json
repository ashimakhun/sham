{
  "expo": {
    "name": "Sham",
    "slug": "sham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {},
      "bundleIdentifier": "com.ashimakhun.sham"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6A66EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ashimakhun.sham"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sham uses your photos so you can attach pictures of your homework."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "scheme": "sham",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e8530336-5f9e-4177-96d7-853d95d227cc"
      }
    }
  }
}
