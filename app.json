{
  "expo": {
    "name": "Sham",
    "slug": "sham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "bundleIdentifier": "com.ashimakhun.sham"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6A66EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ashimakhun.sham",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sham uses your photos so you can attach pictures of your homework.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ru"
            ]
          }
        }
      ]
    ],
    "locales": {
      "ru": "./locales/ios/ru.json"
    },
    "scheme": "sham",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e8530336-5f9e-4177-96d7-853d95d227cc"
      }
    }
  }
}
